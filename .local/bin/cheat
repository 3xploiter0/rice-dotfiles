k "listen [port]"       "catch a reverse shell (pwncat auto-TTY) � default 4444"
k "ports <ip>"          "fast top-ports scan (triage before recon)"
k "fuzz <url> [wl]"     "quick dir brute (feroxbuster; FUZZ -> ffuf)"
k "vhost <domain> [ip]" "virtual-host / subdomain fuzz"
k "spawn"               "print+copy the TTY-stabilize steps"
k "enc <b64|hex|url|rot13> <t>" "encode  �  dec = decode"
k "steg <file>"         "forensics gauntlet (exif/strings/binwalk/steghide)"
k "extract <file>"      "unpack any archive"
k "search <term>"       "searchsploit (Exploit-DB)"
k "smb <ip>"            "quick SMB share enum"
k "magic <text>"        "auto-decode (b64/hex/rot13/url/b32)"
k "crackzip <file>"     "crack zip/rar/pdf/ssh-key (john+rockyou)"
k "sshkey [name]"       "gen ssh key for authorized_keys"
k "www [port]"          "serve CURRENT folder over http"
k "qr <img>"            "decode a QR/barcode"
k "genpass [n]"         "random password  �  rocky <re> = grep rockyou"
k "cve <id>"            "quick CVE lookup"
k "payload <type> [port]" "msfvenom reverse shell (exe/elf/php/war)"
k "tunnel chisel|ligolo" "one-command pivot setup"
k "creds add <box> <u> <p>" "credential vault - creds [query] to search"
k "flag user|root <val>" "record a flag in the box (boxes shows it)"
k "todo \"task\""        "per-box task list - todo done N"
