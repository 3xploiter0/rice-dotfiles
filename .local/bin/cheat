tmuxc(){ h "TMUX  (prefix = Ctrl+b, press then release)"
k "Alt + arrows"        "move between panes"
k "prefix |  /  -"      "split left-right / top-bottom"
k "prefix c"            "new window   ·   prefix 1/2.. switch"
k "prefix z"            "zoom pane fullscreen (toggle)"
k "prefix d"            "detach (scans keep running)"
k "prefix L"            "toggle logging this pane"
k "prefix [ , q"        "scroll mode (q to quit)   ·   mouse works"
k "prefix r"            "reload tmux config"; }

shell(){ h "SHELL SPEED"
k "z <part-of-dir>"     "jump to a folder you've visited"
k "Ctrl+R"              "fuzzy-search command history"
k "Ctrl+T"              "fuzzy-find a file into the command"
k "cat <file>"          "colored syntax view (bat)"
k "ls / ll / la"        "files with icons (eza)"
h "NOTES & LOGS"
k "logs"                "list today's terminal logs"
k "logclean <file>"     "clean a log for a report"
k "nvim notes.md"       "edit notes (i=type, Esc, :w=save, :q=quit)"
k "rice"                "fastfetch + btop + visualizer layout"
h "BACKUP & BURP"
k "rice-backup"         "snapshot all your configs to ~/.rice-dotfiles (git)"
k "rice-backup <url>"   "...and push to a private GitHub repo"
k "sudo timeshift --create -c msg" "full system restore point"
k "burpchrome"          "Chrome routed through Burp (127.0.0.1:8080)"
k "burpcert"            "trust Burp CA (run once, Burp open)"
k "update"              "apt + tools + templates + backup&push (runs weekly auto)"; }

case "$1" in
  htb)     banner; htb ;;
  tmux)    banner; tmuxc ;;
  desktop) banner; desktop ;;
  shell)   banner; shell ;;
  learn)   banner; learn ;;
  ports)   banner; ref_ports ;;
  transfer) banner; ref_transfer ;;
  privesc) banner; ref_privesc ;;
  web)     banner; ref_web ;;
  ad)      banner; ref_ad ;;
  pivot)   banner; ref_pivot ;;
  crack)   banner; ref_crack ;;
  linux)   banner; ref_linux ;;
  windows) banner; ref_windows ;;
  enum)    banner; ref_enum ;;
  *)       banner; desktop; htb; quick; tmuxc; shell; learn; echo ;;
esac
