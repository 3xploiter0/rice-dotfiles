#!/usr/bin/env python3
"""
Telegram Agent — execute commands on your PC from Telegram
Usage: tg-agent <bot_token> <user_id>
Or set env: TG_BOT_TOKEN and TG_USER_ID
"""

import os
import sys
import subprocess
import logging
from datetime import datetime
import requests
import time
import json

# Config from env or args
BOT_TOKEN = os.getenv('TG_BOT_TOKEN') or (sys.argv[1] if len(sys.argv) > 1 else None)
ALLOWED_USER = os.getenv('TG_USER_ID') or (sys.argv[2] if len(sys.argv) > 2 else None)

if not BOT_TOKEN or not ALLOWED_USER:
    print("Usage: tg-agent <bot_token> <user_id>")
    print("Or set: export TG_BOT_TOKEN='...' TG_USER_ID='...'")
    sys.exit(1)

ALLOWED_USER = int(ALLOWED_USER)

# Logging
LOG_DIR = os.path.expanduser('~/.local/share/tg-agent')
os.makedirs(LOG_DIR, exist_ok=True)
LOG_FILE = os.path.join(LOG_DIR, f'agent_{datetime.now().strftime("%Y%m%d")}.log')

logging.basicConfig(
    level=logging.INFO,
    format='%(asctime)s - %(levelname)s - %(message)s',
    handlers=[
        logging.FileHandler(LOG_FILE),
        logging.StreamHandler()
    ]
)
logger = logging.getLogger(__name__)

# Approved commands (whitelist — only these can run)
APPROVED_COMMANDS = {
    'status': 'vpn status',
    'vpn-up': 'vpn htb',
    'vpn-down': 'vpn down',
    'listen': 'listen 4444',
    'target': 'target',
    'boxes': 'boxes',
    'ports': 'ports $TARGET',
    'recon': 'recon $TARGET',
    'ps': 'ps aux | grep -v grep',
    'who': 'whoami',
    'ip': 'hostname -I',
    'date': 'date',
    'uptime': 'uptime',
    'cpu': 'top -bn1 | head -5',
    'mem': 'free -h',
    'disk': 'df -h | head -10',
    'list-labs': 'dlab list',
    'cheat': 'cheat quick',
}

# Add help after dict is defined
APPROVED_COMMANDS['help'] = 'Available: ' + ', '.join(APPROVED_COMMANDS.keys())

def send_message(chat_id, text, parse_mode='HTML'):
    """Send message via Telegram API"""
    url = f'https://api.telegram.org/bot{BOT_TOKEN}/sendMessage'

    # Split long messages (Telegram limit ~4000 chars)
    if len(text) > 4000:
        for chunk in [text[i:i+4000] for i in range(0, len(text), 4000)]:
            requests.post(url, json={
                'chat_id': chat_id,
                'text': chunk,
                'parse_mode': parse_mode
            }, timeout=10)
    else:
        requests.post(url, json={
            'chat_id': chat_id,
            'text': text,
            'parse_mode': parse_mode
        }, timeout=10)

def execute_command(cmd):
    """Execute approved command safely"""
    try:
        result = subprocess.run(
            cmd,
            shell=True,
            capture_output=True,
            text=True,
            timeout=30
        )
        return result.stdout or result.stderr or "✓ Done (no output)"
    except subprocess.TimeoutExpired:
        return "⚠️ Command timed out (30s limit)"
    except Exception as e:
        return f"❌ Error: {str(e)}"

def handle_message(message):
    """Process incoming Telegram message"""
    chat_id = message['chat']['id']
    user_id = message['from']['id']
    text = message.get('text', '').strip()

    # Check authorization
    if user_id != ALLOWED_USER:
        logger.warning(f"Unauthorized access attempt from {user_id}")
        send_message(chat_id, f"❌ Unauthorized (user {user_id})")
        return

    if not text:
        return

    logger.info(f"Command from {user_id}: {text}")

    # Parse command
    parts = text.split(maxsplit=1)
    cmd_name = parts[0].lower()
    cmd_arg = parts[1] if len(parts) > 1 else None

    # Help
    if cmd_name in ['help', '/?', '--help']:
        msg = "<b>🤖 Telegram Agent — Available Commands:</b>\n\n"
        for name, desc in APPROVED_COMMANDS.items():
            msg += f"<code>/{name}</code> — {desc}\n"
        msg += "\n<b>Examples:</b>\n"
        msg += "<code>/status</code> — check VPN status\n"
        msg += "<code>/listen 4444</code> — start listener on port 4444\n"
        msg += "<code>/ports 10.10.11.5</code> — scan ports\n"
        send_message(chat_id, msg)
        return

    # Check if command is approved
    if cmd_name not in APPROVED_COMMANDS:
        send_message(chat_id, f"❌ Unknown command: <code>/{cmd_name}</code>\nType <code>/help</code>")
        return

    # Build full command
    full_cmd = APPROVED_COMMANDS[cmd_name]
    if cmd_arg:
        full_cmd += f" {cmd_arg}"

    # Execute
    send_message(chat_id, f"⏳ Executing: <code>{full_cmd}</code>")
    output = execute_command(full_cmd)

    # Return output
    response = f"<b>✓ {cmd_name}</b>\n<pre>{output[:3500]}</pre>"
    send_message(chat_id, response)

    logger.info(f"Command completed: {cmd_name}")

def poll_updates():
    """Long-poll for Telegram updates"""
    offset = 0
    logger.info("🤖 Agent started, listening for Telegram messages...")

    while True:
        try:
            url = f'https://api.telegram.org/bot{BOT_TOKEN}/getUpdates'
            response = requests.get(url, params={'offset': offset, 'timeout': 30}, timeout=35)
            updates = response.json().get('result', [])

            for update in updates:
                offset = update['update_id'] + 1

                if 'message' in update:
                    handle_message(update['message'])

            if not updates:
                time.sleep(1)

        except requests.exceptions.RequestException as e:
            logger.error(f"Network error: {e}")
            time.sleep(5)
        except Exception as e:
            logger.error(f"Error: {e}")
            time.sleep(5)

if __name__ == '__main__':
    try:
        poll_updates()
    except KeyboardInterrupt:
        logger.info("Agent stopped by user")
        sys.exit(0)
