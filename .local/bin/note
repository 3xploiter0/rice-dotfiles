#!/usr/bin/env bash
# note "text"   append a timestamped line to the current box's notes.md
# note          show the current box's notes
boxdir() {
  local p roots parent
  p="$(realpath "$PWD" 2>/dev/null)"
  roots="$(for r in "$HOME"/labs/*; do realpath "$r" 2>/dev/null; done)"
  while [ "$p" != "/" ] && [ "$p" != "$HOME" ]; do
    parent="$(dirname "$p")"
    if printf '%s
' "$roots" | grep -qxF "$(realpath "$parent" 2>/dev/null)"; then echo "$p"; return; fi
    p="$parent"
  done
  find -L "$HOME"/labs -mindepth 2 -maxdepth 2 -type d -printf '%T@ %p
' 2>/dev/null | sort -rn | head -1 | cut -d' ' -f2-
}
dir="$(boxdir)"; [ -z "$dir" ] && { echo "no box found (cd into ~/labs/<platform>/<box>)"; exit 1; }
f="$dir/notes.md"
if [ $# -eq 0 ]; then
  [ -f "$f" ] && cat "$f" || echo "(no notes for $(basename "$dir"))"
  exit 0
fi
printf -- '- `%s` %s\n' "$(date +%H:%M)" "$*" >> "$f"
echo "noted -> $(basename "$dir")/notes.md"
