#!/usr/bin/env bash
# spawn   print the shell-stabilization steps (copies the python line to clipboard)
G=$'\e[38;2;158;206;106m'; D=$'\e[38;2;86;95;137m'; C=$'\e[38;2;125;207;255m'; X=$'\e[0m'
line='python3 -c '"'"'import pty;pty.spawn("/bin/bash")'"'"
echo "${D}1.${X} ${G}$line${X}"
echo "${D}2.${X} ${G}Ctrl+Z${X}"
echo "${D}3.${X} ${G}stty raw -echo; fg${X}  ${D}(then press Enter twice)${X}"
echo "${D}4.${X} ${G}export TERM=xterm; export SHELL=/bin/bash${X}"
echo "${D}5. size:${X} ${G}stty rows $(tput lines 2>/dev/null||echo 50) cols $(tput cols 2>/dev/null||echo 200)${X}"
command -v xclip >/dev/null && { printf '%s' "$line" | setsid xclip -selection clipboard >/dev/null 2>&1 & echo "${D}(step 1 copied to clipboard)${X}"; }
