#!/usr/bin/env bash
# brief — daily cyber news: latest security headlines + recent CVEs (needs internet)
B=$'\e[38;2;122;162;247m'; G=$'\e[38;2;158;206;106m'; R=$'\e[38;2;247;118;142m'; Y=$'\e[38;2;224;175;104m'; P=$'\e[38;2;187;154;247m'; D=$'\e[38;2;86;95;137m'; W=$'\e[38;2;192;202;245m'; X=$'\e[0m'
hr(){ printf "${D}────────────────────────────────────────────${X}\n"; }

printf "\n${W}  ⚡ cyber brief — %s${X}\n" "$(date '+%A %d %b')"

feed(){ # url  label  color
  printf "\n${2}▌ %s${X}\n" "$3"
  curl -fsS --max-time 8 "$1" 2>/dev/null \
    | tr '\n' ' ' | grep -oP '(?<=<title>).*?(?=</title>)' \
    | sed -e 's/<!\[CDATA\[//g' -e 's/\]\]>//g' \
    | sed -n '2,7p' \
    | sed 's/&amp;/\&/g; s/&#039;/'"'"'/g; s/&quot;/"/g' \
    | while read -r t; do printf "  ${D}•${X} %s\n" "${t:0:88}"; done
}

feed "https://feeds.feedburner.com/TheHackersNews" "$G" "The Hacker News"
feed "https://www.bleepingcomputer.com/feed/"      "$Y" "BleepingComputer"

printf "\n${R}▌ Actively exploited (CISA KEV — newest)${X}\n"
curl -fsS --max-time 8 "https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json" 2>/dev/null \
  | python3 -c '
import sys,json
try: d=json.load(sys.stdin)
except: sys.exit()
for v in sorted(d.get("vulnerabilities",[]), key=lambda x:x.get("dateAdded",""), reverse=True)[:7]:
    cid=v.get("cveID","CVE-?"); name=v.get("vulnerabilityName","")[:70]
    print(f"  {cid}  {name}")
' 2>/dev/null || printf "  ${D}(CVE feed unavailable)${X}\n"

hr
printf "${D}  stay curious. log it: ${X}journal \"…\"  ${D}· full read in your browser${X}\n\n"
