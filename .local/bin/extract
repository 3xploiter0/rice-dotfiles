#!/usr/bin/env bash
# extract <file>   unpack almost any archive by type
f="${1:-}"; [ -f "$f" ] || { echo "usage: extract <archive>"; exit 1; }
case "$f" in
  *.tar.bz2|*.tbz2) tar xjf "$f" ;;
  *.tar.gz|*.tgz)   tar xzf "$f" ;;
  *.tar.xz)         tar xJf "$f" ;;
  *.tar)            tar xf  "$f" ;;
  *.bz2)            bunzip2 "$f" ;;
  *.gz)             gunzip  "$f" ;;
  *.xz)             unxz    "$f" ;;
  *.zip)            unzip   "$f" ;;
  *.rar)            unrar x "$f" 2>/dev/null || 7z x "$f" ;;
  *.7z)             7z x    "$f" ;;
  *.Z)              uncompress "$f" ;;
  *) echo "unknown archive type: $f"; exit 1 ;;
esac && echo "extracted: $f"
