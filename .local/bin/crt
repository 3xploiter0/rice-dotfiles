#!/usr/bin/env bash
# crt <domain>   passive subdomain enum via crt.sh (certificate transparency)
d="${1:-}"; [ -z "$d" ] && { echo "usage: crt <domain>"; exit 1; }
curl -fsS --max-time 15 "https://crt.sh/?q=%25.$d&output=json" 2>/dev/null \
  | jq -r '.[].name_value' 2>/dev/null | sed 's/\*\.//g' | sort -u || echo "crt.sh unavailable"
