#!/usr/bin/env bash
# www [port]   serve the CURRENT folder over http (default 8000), IP pre-filled
port="${1:-8000}"
LHOST="$(~/.local/bin/hackbar vpn plain 2>/dev/null)"; [ -z "$LHOST" ] && LHOST="$(hostname -I|awk '{print $1}')"
G=$'\e[38;2;158;206;106m'; B=$'\e[38;2;122;162;247m'; X=$'\e[0m'
echo "${B}serving${X} $PWD  ->  ${G}http://$LHOST:$port/${X}"
exec python3 -m http.server "$port"
