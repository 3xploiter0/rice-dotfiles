#!/usr/bin/env bash
# boxes [platform]  — progress tracker across all platforms under ~/cyber/labs
#   boxes            every box (htb, thm, pg, vulnhub, ctf, bugbounty)
#   boxes htb        only that platform
# Reads each box's notes.md "## Flags" for user:/root: values.
ROOT="$HOME/cyber/labs"
B=$'\e[38;2;122;162;247m'; G=$'\e[38;2;158;206;106m'; P=$'\e[38;2;187;154;247m'; D=$'\e[38;2;86;95;137m'; W=$'\e[38;2;192;202;245m'; X=$'\e[0m'
[ -d "$ROOT" ] || { echo "no ~/cyber/labs yet — start one with: htb <ip> <name>  (or thm/pg/vh/ctf)"; exit 0; }
filter="${1:-}"

total=0; du_=0; dr=0
printf "${W}%-10s %-20s %-6s %-6s %s${X}\n" "PLATFORM" "BOX" "USER" "ROOT" "STARTED"
echo "${D}──────────────────────────────────────────────────────────${X}"
for d in $(find -L "$ROOT" -mindepth 2 -maxdepth 2 -type d -printf '%P\n' 2>/dev/null | sort); do
  plat="${d%%/*}"; name="${d#*/}"
  [ -n "$filter" ] && [ "$plat" != "$filter" ] && continue
  total=$((total+1)); n="$ROOT/$d/notes.md"; u="-"; r="-"
  if [ -f "$n" ]; then
    grep -qiE '^- *user:[[:space:]]*\S' "$n" && { u="✓"; du_=$((du_+1)); }
    grep -qiE '^- *root:[[:space:]]*\S' "$n" && { r="✓"; dr=$((dr+1)); }
  fi
  started=$(stat -L -c %y "$ROOT/$d" 2>/dev/null | cut -d' ' -f1)
  uc=$([ "$u" = "✓" ] && echo "$G" || echo "$D"); rc=$([ "$r" = "✓" ] && echo "$G" || echo "$D")
  printf "${P}%-10s${X} %-20s ${uc}%-6s${X} ${rc}%-6s${X} ${D}%s${X}\n" "$plat" "$name" "$u" "$r" "$started"
done
echo "${D}──────────────────────────────────────────────────────────${X}"
printf "${B}%s boxes${X}  ·  ${G}%s user${X}  ·  ${G}%s root${X}   ${D}(platforms: htb thm pg vulnhub ctf bugbounty)${X}\n" "$total" "$du_" "$dr"
