#!/usr/bin/env bash
# Menu-bar app name (like macOS): prints the focused application's name for xfce4-genmon.
id=$(xprop -root _NET_ACTIVE_WINDOW 2>/dev/null | grep -o '0x[0-9a-f]*' | head -1)
if [ -z "$id" ] || [ "$id" = "0x0" ] || [ "$id" = "found." ]; then echo "<txt><b>Desktop</b></txt>"; exit 0; fi
cls=$(xprop -id "$id" WM_CLASS 2>/dev/null | awk -F'"' '{print $4}')
case "${cls,,}" in
  google-chrome|chrome) n="Google Chrome" ;;
  qterminal) n="Terminal" ;;
  thunar) n="Finder" ;;
  code) n="Code" ;;
  xfdesktop|"") n="Desktop" ;;
  xfce4-panel|plank) n="Desktop" ;;
  org.gnome.*) n="${cls##*.}" ;;
  *) n="${cls^}" ;;
esac
echo "<txt><b>${n}</b></txt>"
