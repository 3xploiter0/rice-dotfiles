configuration { show-icons: true; icon-theme: "Papirus-Dark"; drun-display-format: "{name}"; }
/* macOS Launchpad — fullscreen frosted app grid, Tokyo Night (theme only) */
* {
  bg:    #1a1b26f2;
  fg:    #c0caf5;
  hl:    #7aa2f7;
  sel:   #292e42cc;
  muted: #565f89;
  background-color: transparent;
  text-color: @fg;
}
window {
  fullscreen: true;
  background-color: @bg;
  padding: 6% 8%;
  children: [ inputbar, listview ];
}
inputbar {
  children: [ entry ];
  margin: 0 30% 28px 30%;
  padding: 12px 18px;
  border-radius: 12px;
  background-color: #ffffff14;
}
entry {
  placeholder: "Search apps";
  placeholder-color: @muted;
  text-color: @fg;
  font: "Inter 14";
}
listview {
  columns: 7;
  lines: 4;
  spacing: 24px;
  cycle: true;
  dynamic: true;
  scrollbar: false;
  flow: horizontal;
}
element {
  orientation: vertical;
  padding: 18px 8px;
  spacing: 10px;
  border-radius: 16px;
}
element-icon {
  size: 68px;
  horizontal-align: 0.5;
}
element-text {
  horizontal-align: 0.5;
  vertical-align: 0.5;
  font: "Inter 11";
  text-color: @fg;
}
element selected {
  background-color: @sel;
  text-color: #ffffff;
}
