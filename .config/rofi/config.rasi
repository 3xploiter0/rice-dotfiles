configuration { show-icons: true; icon-theme: "Papirus-Dark"; drun-display-format: "{name}"; }
* { bg: #1e1e2e; fg: #bac2de; hl: #89b4fa; sel: #45475a; muted: #6c7086; background-color: transparent; text-color: @fg; font: "JetBrainsMono Nerd Font 11"; }
window { width: 640px; background-color: @bg; border: 2px; border-color: @hl; border-radius: 0; padding: 14px; }
mainbox { children: [inputbar, listview]; }
inputbar { children: [entry]; padding: 8px; border: 0 0 1px 0; border-color: @sel; }
entry { placeholder: "Search..."; placeholder-color: @muted; cursor: text; }
listview { lines: 9; spacing: 2px; margin: 10px 0 0 0; scrollbar: false; }
element { padding: 6px 8px; spacing: 10px; background-color: transparent; }
element normal.normal { background-color: transparent; text-color: @fg; }
element alternate.normal { background-color: transparent; text-color: @fg; }
element-icon { size: 22px; background-color: transparent; }
element selected { background-color: @sel; text-color: @hl; }
element-text { text-color: inherit; background-color: transparent; }
