configuration { modi: "drun,run,window"; show-icons: true; icon-theme: "Papirus-Dark"; font: "JetBrains Mono 11"; display-drun: ""; drun-display-format: "{name}"; }
* { bg: #1a1b26; fg: #a9b1d6; hl: #7aa2f7; sel: #292e42; muted: #565f89; background-color: transparent; text-color: @fg; }
window { width: 640px; background-color: @bg; border: 2px; border-color: @hl; border-radius: 0; padding: 14px; }
mainbox { children: [inputbar, listview]; }
inputbar { children: [entry]; padding: 8px; border: 0 0 1px 0; border-color: @sel; }
entry { placeholder: "Search..."; placeholder-color: @muted; cursor: text; }
listview { lines: 9; spacing: 2px; margin: 10px 0 0 0; scrollbar: false; }
element { padding: 6px 8px; spacing: 10px; }
element-icon { size: 20px; }
element selected { background-color: @sel; text-color: @hl; }
element-text { text-color: inherit; }
